# Copy to .env in the repository root. Never commit real credentials.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PostgreSQL is the default; create this database before running migrations.
DATABASE_URL=postgresql://petrol:change-me@localhost:5432/petrol_station
# Optional local development only: remove DATABASE_URL and set this to true.
USE_SQLITE=false
DJANGO_TIME_ZONE=Asia/Kabul
DJANGO_SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto only behind a proxy that strips client-supplied values.
DJANGO_TRUST_PROXY_SSL=false
# Production defaults to a shared database cache: run manage.py createcachetable.
# The development default is locmem; production rejects locmem.
DJANGO_CACHE_BACKEND=locmem
DJANGO_CACHE_LOCATION=petrol-development
# Keep 0 for direct access. Use 1 only behind the documented trusted proxy.
DJANGO_NUM_PROXIES=0
# File storage for local/VPS; database storage for the free Render/Neon demo.
DJANGO_LOGO_STORAGE=file
DJANGO_DISABLE_SERVER_SIDE_CURSORS=true
# Same-origin reverse proxy recommended for session cookies in production.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=http://127.0.0.1:8000
