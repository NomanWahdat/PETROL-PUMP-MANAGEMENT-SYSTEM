# Include in nginx's http context (for example sites-enabled on Debian/Ubuntu).
# Replace station.example, paths and TLS certificate locations before installing.
limit_req_zone $binary_remote_addr zone=petrol_login:10m rate=10r/m;

server {
    listen 80;
    server_name station.example;
    return 301 https://station.example$request_uri;
}

server {
    listen 443 ssl;
    server_name station.example;
    ssl_certificate /etc/letsencrypt/live/station.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/station.example/privkey.pem;
    root /srv/petrol/frontend/dist;
    index index.html;
    client_max_body_size 3m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # This proxy is the sole trusted hop. Replace rather than append client headers.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_read_timeout 65s;

    location = /api/v1/auth/login/ {
        limit_req zone=petrol_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
        proxy_no_cache 1;
        add_header Cache-Control no-store always;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_no_cache 1;
        add_header Cache-Control no-store always;
    }
    location /admin/ { proxy_pass http://127.0.0.1:8000; }
    location /static/ { alias /srv/petrol/backend/staticfiles/; }
    # Tenant logos must pass through the authenticated logo API.
    location /media/ { return 404; }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control no-cache;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }
}
