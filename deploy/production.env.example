# Example only. Store real values in a restricted server environment file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=station.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://station.example
DATABASE_URL=postgresql://petrol:URL_ENCODED_PASSWORD@127.0.0.1:5432/petrol_station
USE_SQLITE=false
DJANGO_TIME_ZONE=Asia/Kabul
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_PROXY_SSL=true
DJANGO_NUM_PROXIES=1
DJANGO_CACHE_BACKEND=database
DJANGO_CACHE_LOCATION=petrol_cache
DJANGO_LOGO_STORAGE=file
DJANGO_DISABLE_SERVER_SIDE_CURSORS=true
VITE_API_BASE_URL=/api/v1
