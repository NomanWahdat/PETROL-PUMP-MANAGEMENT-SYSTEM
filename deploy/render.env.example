# Render dashboard only; replace placeholders. Never put credentials in Git.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DATABASE_URL=YOUR_NEON_POSTGRES_CONNECTION_STRING_WITH_SSL
DJANGO_CSRF_TRUSTED_ORIGINS=https://YOUR-PROJECT.vercel.app
DJANGO_LOGO_STORAGE=database
DJANGO_CACHE_BACKEND=database
DJANGO_CACHE_LOCATION=petrol_cache
DJANGO_TRUST_PROXY_SSL=true
DJANGO_NUM_PROXIES=0
DJANGO_DISABLE_SERVER_SIDE_CURSORS=true
USE_SQLITE=false
DJANGO_TIME_ZONE=Asia/Kabul
